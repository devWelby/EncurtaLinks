{
  "name": "encurtalinks",
  "version": "0.1.0",
  "private": true,
  "description": "EncurtaLinks — encurtador de links gratuito com página intermediária e publicidade identificada.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build:public && npm run build:admin",
    "build:public": "vite build --config apps/public/vite.config.ts",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.ts",
    "db:restore-drill": "node scripts/restore-drill.ts",
    "check:secrets": "node scripts/check-bundle-secrets.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:secrets && npm run test:e2e"
  },
  "dependencies": {
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@netlify/functions": "6.0.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
