# =============================================================================
# EncurtaLinks — variáveis de ambiente (EXEMPLO, sem nenhum valor real)
# =============================================================================
#
# Onde configurar:
#   - Produção / staging: no painel do Netlify, em CADA site
#     (Site configuration → Environment variables), com valores por contexto
#     (Production, Deploy Previews, Branch deploys). Marque os segredos como
#     "secret" e NUNCA os coloque no netlify.toml nem no repositório.
#   - Desenvolvimento local: `npm run dev` já define tudo o que precisa
#     (banco embarcado, antiautomação simulado). Este arquivo só serve para
#     sobrescrever algo; copie para `.env` (ignorado pelo git) se precisar.
#
# Detalhes de cada variável: docs/configuracao.md
#
# Legenda:  [S] segredo   [P] público/não secreto   [B] usada no build do frontend
#           (pub) site público   (adm) painel administrativo   (ambos)
# =============================================================================

# --- Ambiente -----------------------------------------------------------------
# (ambos) [P] O contexto de deploy do Netlify prevalece: "production" é sempre produção.
# Valores: development | test | preview | staging | production
APP_ENV=development

# --- Endereços (somente a origem, sem caminho) ---------------------------------
# (ambos) [P] Obrigatórias em produção, com https.
PUBLIC_SITE_URL=https://SEU-SITE-PUBLICO.netlify.app
ADMIN_SITE_URL=https://SEU-PAINEL.netlify.app

# --- Banco de dados PostgreSQL --------------------------------------------------
# (ambos) [S] Conexão das funções (usuário com permissões de aplicação).
# Neon: use a URL "pooled" (-pooler). Produção, previews e branch deploys
# devem usar bancos DIFERENTES (ex.: branches separadas no Neon).
DATABASE_URL=postgres://USUARIO:SENHA@HOST/BANCO?sslmode=require
# (ambos) [S] Opcional: conexão só para migrações (dono do schema); padrão = DATABASE_URL.
# Neon: use a URL direta (sem -pooler), pois migrações usam advisory lock.
DATABASE_MIGRATION_URL=
# (ambos) [P] "verify" (padrão; TLS com verificação de certificado) ou "disable" (somente local).
DATABASE_SSL=verify
# (ambos) [P] Opcional: CA em PEM (quebras de linha como \n) se o provedor exigir.
DATABASE_CA_CERT=

# --- Privacidade ------------------------------------------------------------------
# (ambos) [S] Chave do HMAC que transforma IPs em identificadores (nunca guardamos o IP).
# Mínimo 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
IP_HASH_SECRET=

# --- Antiautomação (Cloudflare Turnstile) -----------------------------------------
# (pub) [S] Chave secreta do widget. Previews podem usar a chave de TESTE da Cloudflare;
# produção recusa chaves de teste.
TURNSTILE_SECRET_KEY=
# (pub) [P][B] Chave pública (site key) do mesmo widget — vai para o navegador.
VITE_TURNSTILE_SITE_KEY=
# (pub) Somente local/testes: "test" simula o desafio. Recusado em qualquer deploy.
# ANTIBOT_MODE=test
# VITE_ANTIBOT_MODE=test

# --- Login administrativo (GitHub OAuth App) ---------------------------------------
# (adm) [P] Client ID do OAuth App (callback: ADMIN_SITE_URL + /auth/github/callback).
GITHUB_CLIENT_ID=
# (adm) [S] Client secret do OAuth App.
GITHUB_CLIENT_SECRET=
# (adm) [P] IDs NUMÉRICOS das contas autorizadas, separados por vírgula
# (consulte em https://api.github.com/users/SEU_LOGIN → campo "id").
ADMIN_GITHUB_USER_IDS=
# (adm) [P] Exige verificação em duas etapas na conta GitHub (padrão: true).
ADMIN_REQUIRE_GITHUB_2FA=true
# (adm) [P] Duração máxima da sessão e expiração por inatividade, em segundos.
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_IDLE_SECONDS=1800

# --- Publicidade (Adsterra) — DESLIGADA por padrão ---------------------------------
# (pub) [P] Ligue somente no contexto Production, depois da aprovação do site no
# Adsterra. O interruptor do painel (Configurações) também precisa estar ligado.
ADS_ENABLED=false
# (pub) [P] Pede consentimento antes de carregar qualquer script de anúncio (padrão: true).
ADS_REQUIRE_CONSENT=true
# (pub) [P] Tags EXATAS copiadas do painel do Adsterra (banner / native banner).
# Somente scripts https; iframes, formulários e similares são recusados.
ADSTERRA_SLOT_PRIMARY_HTML=
ADSTERRA_SLOT_SECONDARY_HTML=
# (pub) [P] Origens extras exigidas pelas tags, separadas por espaço (ex.: https://cdn.exemplo.com).
ADS_CSP_SCRIPT_SRC=
ADS_CSP_FRAME_SRC=
ADS_CSP_CONNECT_SRC=
ADS_CSP_IMG_SRC=
ADS_CSP_STYLE_SRC=
# (pub) [P] Fora de produção, mostra um espaço simulado no lugar do anúncio (padrão: true).
ADS_DEV_PLACEHOLDER=true

# --- Página intermediária -----------------------------------------------------------
# (pub) [P] Validade do ticket de continuação (60–86400 s; padrão 1800).
TICKET_TTL_SECONDS=1800
# (pub) [P] Espera mínima antes de continuar, validada no servidor (0–15 s; padrão 0 = sem espera).
CONTINUE_MIN_WAIT_SECONDS=0
# (pub) [P] Bloqueio automático quando o link recebe denúncias abertas de N origens
# distintas em 24 h (0 = nunca; padrão 5). O administrador pode desbloquear.
REPORT_AUTO_BLOCK_THRESHOLD=5

# --- Limites de uso (aplicados no PostgreSQL; respondem 429 + Retry-After) ----------
RATE_LIMIT_CREATE_PER_IP_10MIN=10
RATE_LIMIT_CREATE_PER_IP_DAILY=50
RATE_LIMIT_CREATE_GLOBAL_HOURLY=600
RATE_LIMIT_REPORT_PER_IP_HOURLY=5
RATE_LIMIT_REPORT_GLOBAL_HOURLY=200
RATE_LIMIT_VIEW_PER_IP_MINUTE=120
RATE_LIMIT_CONTINUE_PER_IP_MINUTE=120
RATE_LIMIT_ADMIN_API_PER_SESSION_10MIN=600
RATE_LIMIT_ADMIN_AUTH_PER_IP_10MIN=20

# --- Somente local / CI (nunca no Netlify) -------------------------------------------
# PostgreSQL local existente em vez do embarcado (somente localhost):
# DEV_DATABASE_URL=postgres://postgres:postgres@localhost:5432/encurtalinks_dev
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/encurtalinks_test
# E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/encurtalinks_e2e
# Ensaio de backup: ferramentas pg_dump/pg_restore e (opcional) banco de origem SOMENTE LEITURA.
# PG_BIN_DIR=/usr/lib/postgresql/17/bin
# RESTORE_DRILL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# RESTORE_DRILL_SOURCE_URL=
